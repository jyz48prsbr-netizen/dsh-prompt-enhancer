{
  "name": "dsh-prompt-enhancer",
  "version": "1.0.0",
  "description": "DeepSeek Harness plugin: an Enhance Prompt button beside the composer model picker. Prompts are verbatim from WorkBuddy; interactions follow two proven DSH plugins.",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jyz48prsbr-netizen/dsh-prompt-enhancer.git"
  },
  "homepage": "https://github.com/jyz48prsbr-netizen/dsh-prompt-enhancer#readme",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness"
  ]
}
